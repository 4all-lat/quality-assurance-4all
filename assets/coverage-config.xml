<!-- Coverage Configuration Snippet for .NET / Coverlet -->
<!-- Add this to your test project .csproj file inside <ProjectGroup> -->

<PropertyGroup>
  <CollectCoverage>true</CollectCoverage>
  <CoverletOutputFormat>cobertura,opencover</CoverletOutputFormat>
  <CoverletOutputDirectory>$(MSBuildThisFileDirectory)coverage/</CoverletOutputDirectory>
  <Threshold>80</Threshold>
  <ThresholdType>line</ThresholdType>
  <ThresholdStat>total</ThresholdStat>
  <Exclude>[*Tests]*,*Migrations*</Exclude>
  <ExcludeByAttribute>Obsolete,GeneratedCode,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
  <SkipAutoProps>true</SkipAutoProps>
  <UseSourceLink>false</UseSourceLink>
  <SingleHit>false</SingleHit>
  <IncludeTestAssembly>false</IncludeTestAssembly>
</PropertyGroup>

<!--
  Explanation of key settings:

  - CollectCoverage: Enables coverage collection during `dotnet test`
  - CoverletOutputFormat: Generate both Cobertura (CI) and OpenCover (ReportGenerator) formats
  - Threshold: Build fails if line coverage drops below 80%
  - ThresholdType: Measure line coverage (alternatives: branch, method)
  - ThresholdStat: Total across all assemblies (alternatives: min, max, average)
  - Exclude: Skip test projects and EF Core migrations
  - ExcludeByAttribute: Skip code marked with these attributes
  - SkipAutoProps: Don't count auto-properties (get/set without logic)
  - IncludeTestAssembly: Set to true if you want coverage of the test project itself

  Usage:
    dotnet test --collect:"XPlat Code Coverage"

  Generate HTML report:
    dotnet tool install -g dotnet-reportgenerator-globaltool
    reportgenerator -reports:**/coverage.cobertura.xml -targetdir:coverage-report -reporttypes:Html

  For Vitest (Node.js/TS), use vitest.config.ts instead:
    test: {
      coverage: {
        provider: 'c8',
        reporter: ['text', 'html', 'cobertura'],
        thresholds: { lines: 80, functions: 80, branches: 80, statements: 80 },
        exclude: ['node_modules/', 'dist/', '**/*.config.*'],
      }
    }

  For Python, use .coveragerc:
    [run]
    source = ./src
    omit = */migrations/* */tests/* */config/*
    [report]
    fail_under = 80
    show_missing = True
    [html]
    directory = coverage_html_report
-->
