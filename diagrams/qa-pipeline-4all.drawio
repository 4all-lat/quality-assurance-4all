<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17" type="device">
  <diagram id="pg0" name="00 · Pipeline QA (11 fases)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p0-title" value="Pipeline QA 4All — de la especificación a producción" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1000" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p0-sub" value="11 fases organizadas como una pirámide de calidad. Cada fase tiene un gate que debe pasar antes de avanzar a la siguiente; la capa inferior sostiene a la superior." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1400" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="p0-band1" value="1 · DEFINICIÓN — la spec es la fuente de verdad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="1520" height="122" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f1" value="&lt;b&gt;F1 · Especificación&lt;/b&gt;&lt;br&gt;SDD — Spec-Driven Development&lt;br&gt;&lt;i&gt;Gate: spec revisada y aprobada antes de escribir código, con sus abuse cases recorridos&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="126" width="270" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="p0-der" value="&lt;b&gt;De la spec se deriva todo:&lt;/b&gt;&lt;br&gt;Historias de usuario  ·  Escenarios BDD (F3)  ·  Tests unitarios (F2)  ·  Tests de integración (F4)  ·  Documentación / OpenAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#9db8d9;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="126" width="1180" height="68" as="geometry"/>
        </mxCell>

        <mxCell id="p0-band2" value="2–5 · CONSTRUCCIÓN — pirámide de tests (70% unitarios / 20% integración / 10% E2E)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="228" width="1520" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f2" value="&lt;b&gt;F2 · Unit testing&lt;/b&gt;&lt;br&gt;TDD: Red → Green → Refactor&lt;br&gt;&lt;i&gt;Gate: cada método público con test · cobertura ≥ 80%&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="52" y="266" width="355" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f3" value="&lt;b&gt;F3 · BDD&lt;/b&gt;&lt;br&gt;Gherkin: Given-When-Then&lt;br&gt;&lt;i&gt;Gate: cada criterio de aceptación con ≥ 1 escenario&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="432" y="266" width="355" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f4" value="&lt;b&gt;F4 · Integración + contratos&lt;/b&gt;&lt;br&gt;In-memory (TestServer) + live · Pact / OpenAPI&lt;br&gt;&lt;i&gt;Gate: matriz endpoint × tenant · aislamiento por contenido · un solo efecto bajo concurrencia&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="812" y="266" width="355" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f5" value="&lt;b&gt;F5 · Property-based&lt;/b&gt;&lt;br&gt;FsCheck · fast-check · Hypothesis&lt;br&gt;&lt;i&gt;Gate: 200+ casos aleatorios por propiedad&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1192" y="266" width="355" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="p0-band3" value="6–9 · VALIDACIÓN NO FUNCIONAL — seguridad, rendimiento y eficacia real de los tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="386" width="1520" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f6" value="&lt;b&gt;F6 · Seguridad&lt;/b&gt;&lt;br&gt;OWASP API Security Top 10 + escaneos estáticos (SCA, secretos, SAST, SBOM)&lt;br&gt;&lt;i&gt;Gate: 10 riesgos testeados · SQLi no ejecuta · sin stack traces · ningún hallazgo high/critical&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="52" y="424" width="355" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f7" value="&lt;b&gt;F7 · Rendimiento&lt;/b&gt;&lt;br&gt;Carga: P50 / P95 / P99 · throughput · memoria&lt;br&gt;&lt;i&gt;Gate: P95 en objetivo · errores &amp;lt; 0.1% · sin fugas&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="432" y="424" width="355" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f8" value="&lt;b&gt;F8 · Cobertura de código&lt;/b&gt;&lt;br&gt;Coverlet · @vitest/coverage-v8 · coverage.py&lt;br&gt;&lt;i&gt;Gate: ≥ 80% de líneas · el build falla por debajo&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="812" y="424" width="355" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f9" value="&lt;b&gt;F9 · Mutation testing&lt;/b&gt;&lt;br&gt;Stryker.NET · Stryker.js · mutmut&lt;br&gt;&lt;i&gt;Gate: mutation score ≥ 60% (≥ 80% en sistemas críticos)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1192" y="424" width="355" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="p0-band4" value="10–11 · ENTREGA Y OPERACIÓN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="544" width="1520" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f10" value="&lt;b&gt;F10 · Estratificación de la regresión&lt;/b&gt;&lt;br&gt;Smoke (~30 s, cada commit) · Regression (~5 min, cada PR, incluye concurrencia y el subconjunto SecurityPR) · Full (~15 min, nightly / pre-release, incluye escaneos estáticos)&lt;br&gt;&lt;i&gt;Gate: Smoke en cada commit · Regression en cada PR · Full antes de cada release · presupuesto por tier aplicado con --enforce-budget&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="52" y="582" width="730" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="p0-f11" value="&lt;b&gt;F11 · Calidad en producción&lt;/b&gt;&lt;br&gt;Checklist pre-producción · SLOs y alertas · validación post-deploy · rollback&lt;br&gt;&lt;i&gt;Gate: checklist completo y validación post-despliegue correcta&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="812" y="582" width="730" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="p0-note" value="Prácticas transversales a todas las fases (tests flaky, datos de test, accesibilidad, regresión visual, code review y Definition of Done) → pestaña «10 · Prácticas transversales y anti-patrones».&lt;br&gt;Documentación de referencia: references/quality-gates.md · owasp-api-testing.md · test-pyramid.md · contract-testing.md · performance-testing.md · quality-engineering-practices.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1520" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p0-legend" value="Leyenda" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="712" width="90" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="p0-lg1" value="Definición / construcción" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="712" width="200" height="32" as="geometry"/>
